    "@neondatabase/serverless": "1.2.0",
    "@vercel/oidc": "4.0.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "htmlparser2": "12.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
