DATABASE_URL=postgresql://your-project-pooled-url
DATABASE_URL_UNPOOLED=postgresql://your-project-direct-url
NEON_AUTH_BASE_URL=https://your-project.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-at-least-32-random-characters
# Optional: Vercel injects OIDC credentials for AI Gateway deployments.
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# AI_GATEWAY_API_KEY=
